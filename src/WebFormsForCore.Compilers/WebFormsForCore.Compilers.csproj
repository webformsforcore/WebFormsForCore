<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <DebugType>portable</DebugType>
        <AssemblyName>WebFormsForCore.Compilers</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        
        <PackageId>WebFormsForCore.Compilers</PackageId>
        <Title>WebFormsForCore.Compilers</Title>
        <Product>WebFormsForCore.Compilers</Product>
        <Description>A port of ASP.NET WebForms to .NET 10</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>WebForms;porting WebForms;NET Core;NET 10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net8.0'">
        <PackageReference Include="Microsoft.CodeAnalysis" Version="4.13.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.13.0" />
    </ItemGroup>
    
    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.3.0" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net11.0'">
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Roslyn.net8.0\**\*.*">
            <!--<Link>Compilers\%(RecursiveDir)%(Filename)%(Extension)</Link>-->
            <Pack>True</Pack>
            <PackagePath>lib\net8.0</PackagePath>
        </Content>
        <Content Include="Roslyn.net10.0\**\*.*">
            <!--<Link>Compilers\%(RecursiveDir)%(Filename)%(Extension)</Link>-->
            <Pack>True</Pack>
            <PackagePath>lib\net10.0</PackagePath>
        </Content>
        <Content Include="Roslyn.net11.0\**\*.*">
            <!--<Link>Compilers\%(RecursiveDir)%(Filename)%(Extension)</Link>-->
            <Pack>True</Pack>
            <PackagePath>lib\net11.0</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
